{
  "name": "@voicefield/server",
  "version": "0.2.8",
  "description": "Voicefield server-side relay for Next.js",
  "keywords": ["voicefield", "voice-input", "speech-to-text", "nextjs", "sse", "relay", "server"],
  "homepage": "https://voicefield.dev",
  "repository": { "type": "git", "url": "https://github.com/tatargabor/voicefield", "directory": "packages/server" },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "lint": "eslint src/",
    "test": "vitest run"
  },
  "dependencies": {
    "@voicefield/core": "workspace:^0.2.8"
  },
  "peerDependencies": {
    "next": ">=14.0.0",
    "@soniox/node": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "@soniox/node": {
      "optional": true
    }
  },
  "devDependencies": {
    "next": "^15.0.0",
    "typescript": "^5.7.0",
    "@types/node": "^22.0.0"
  }
}
