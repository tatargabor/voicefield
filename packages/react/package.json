{
  "name": "@voicefield/react",
  "version": "0.2.7",
  "description": "React hook and components for Voicefield voice input",
  "keywords": ["react", "voice-input", "speech-to-text", "stt", "hook", "microphone", "qr-code", "web-speech-api", "dictation", "voicefield"],
  "homepage": "https://voicefield.dev",
  "repository": { "type": "git", "url": "https://github.com/tatargabor/voicefield", "directory": "packages/react" },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./phone": {
      "types": "./dist/phone-page.d.ts",
      "import": "./dist/phone-page.js",
      "default": "./dist/phone-page.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "lint": "eslint src/",
    "test": "vitest run"
  },
  "dependencies": {
    "@voicefield/core": "workspace:^0.2.7",
    "qrcode": "^1.5.0"
  },
  "peerDependencies": {
    "@soniox/client": ">=2.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "@soniox/client": {
      "optional": true
    }
  },
  "devDependencies": {
    "@soniox/client": "^2.1.0",
    "@types/qrcode": "^1.5.0",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.7"
  }
}
